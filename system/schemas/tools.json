[
 {
  "name": "echo_artifact",
  "version": "1.0",
  "description": "Contract test: writes the message as an artifact and reports its hash.",
  "capabilities": [
   "contract-test"
  ],
  "input_schema": {
   "properties": {
    "message": {
     "title": "Message",
     "type": "string"
    }
   },
   "required": [
    "message"
   ],
   "title": "EchoIn",
   "type": "object"
  },
  "output_schema": {
   "properties": {
    "sha256": {
     "title": "Sha256",
     "type": "string"
    },
    "length": {
     "title": "Length",
     "type": "integer"
    },
    "host_os": {
     "title": "Host Os",
     "type": "string"
    }
   },
   "required": [
    "sha256",
    "length",
    "host_os"
   ],
   "title": "EchoOut",
   "type": "object"
  },
  "platforms": [
   "windows",
   "linux"
  ],
  "engines": [
   "*"
  ],
  "permissions": [
   "read"
  ],
  "side_effects": [],
  "artifacts": [
   "echo.txt"
  ],
  "timeout_s": 60.0,
  "retries": 0,
  "validation": "artifact hash and length match output"
 },
 {
  "name": "scan_library",
