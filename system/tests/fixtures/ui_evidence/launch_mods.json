{
  "title": "Launch screen: what a modded launch replaces (marquee + slides) and what is on",
  "branch": "launch-screen-mods",
  "about": "Synthetic DOA2-like cast build (no game files). Also read by tests/test_launch_mods.cjs.",
  "include": ["_web_shell.json"],
  "lists": ["/api/mods"],
  "local_storage": {"gbox_modkeep_doa2": ["m_unlock", "m_link"]},
  "routes": {
    "/api/catalog/doa2": {"game_id": "doa2", "title": "Dead or Alive 2 - Limited Edition (Japan)", "system": "Sega Dreamcast",
                          "platform": "dreamcast", "core": "flycast"},
    "/api/catalog/taxi": {"game_id": "taxi", "title": "Crazy Taxi (USA)", "system": "Sega Dreamcast", "platform": "dreamcast", "core": "flycast"},
    "POST /api/games/doa2/launch": {"id": "L1", "tool": "launch_game", "state": "queued", "created": "$now"},
    "POST /api/games/taxi/launch": {"id": "L2", "tool": "launch_game", "state": "queued", "created": "$now"},
    "/api/jobs/L2": {"id": "L2", "tool": "launch_game", "state": "running", "created": "$now-3", "progress": {"pct": 18, "msg": "Starting flycast", "ts": "$now"}},
    "/api/jobs/L1": {"id": "L1", "tool": "launch_game", "state": "running", "created": "$now-4",
                     "progress": {"pct": 41, "msg": "Staging doa2_sonic_cast: 512/1272 MB", "ts": "$now"}},
    "/api/mods": [
      {"id": "m_unlock", "title": "Unlock all costumes", "game_id": "doa2", "calls": [{"tool": "cheats", "input": {"codes": ["0c1a2b3c 00000001"]}}]},
      {"id": "m_link", "title": "Bullet-cam link", "game_id": "doa2", "calls": [{"tool": "game_link", "input": {"op": "start"}}]},
      {"id": "m_other", "title": "Not kept", "game_id": "doa2", "calls": [{"tool": "cheats", "input": {}}]}
    ],
    "/api/mods/built": {"total": 1, "items": [
      {"key": "doa2/doa2_sonic_cast", "name": "doa2_sonic_cast", "game_id": "doa2", "title": "Dead or Alive 2", "display_name": "Sonic crew in DOA2",
       "mod_title": "Sonic crew in DOA2", "original_title": "doa2 roster: sonic cast", "writer": "doa2_swap", "built": "$now-7200", "verified": false,
       "changes": [{"donor": "amy_rose", "slot": "KAS"}, {"donor": "sonic", "slot": "HAY"}, {"donor": "shadow", "slot": "RYU"},
                   {"donor": "knuckles", "slot": "BAS"}, {"donor": "rouge", "slot": "TIN"}, {"donor": "big_the_cat", "slot": "TEN"}],
       "donor_previews": [{"slug": "amy_rose", "url": "/api/characters/amy_rose/preview"}, {"slug": "sonic", "url": "/api/characters/sonic/preview"},
                          {"slug": "shadow", "url": "/api/characters/shadow/preview"}, {"slug": "knuckles", "url": "/api/characters/knuckles/preview"},
                          {"slug": "rouge", "url": "/api/characters/rouge/preview"}, {"slug": "big_the_cat", "url": "/api/characters/big_the_cat/preview"}]}
    ]},
    "/api/builds/doa2/doa2_sonic_cast/details": {
      "key": "doa2/doa2_sonic_cast", "name": "doa2_sonic_cast", "game_id": "doa2", "label": "Sonic crew in DOA2", "display_name": "Sonic crew in DOA2",
      "original_title": "doa2 roster: sonic cast", "kinds": ["cast", "cheats"], "writer": "doa2_swap", "built": "$now-7200",
      "modifications": {"files": [{"path": "doa2.gdi", "change": "image", "what": "the built image the launch boots"},
                                  {"path": "track03/KAS_C1.BIN", "change": "replaced"}, {"path": "track03/HAY_C1.BIN", "change": "replaced"},
                                  {"path": "track03/SELECT.PVR", "change": "patched"}], "derived": false},
      "characters": [
        {"slot": "KAS", "slot_name": "KAS", "status": "built", "donors": ["amy_rose"], "fit_preview": "/api/jobs/jdoa2/fitting/files/amy-2.png",
         "donor": {"slug": "amy_rose", "name": "Amy Rose", "preview_url": "/api/characters/amy_rose/preview"},
         "original": {"slug": "doa2_kasumi", "name": "Kasumi", "source": "Dead or Alive 2", "preview_url": "/api/characters/doa2_kasumi/preview"}},
        {"slot": "HAY", "slot_name": "HAY", "status": "built", "donors": ["sonic"], "fit_preview": "",
         "donor": {"slug": "sonic", "name": "Sonic", "preview_url": "/api/characters/sonic/preview"},
         "original": {"slug": "doa2_hayabusa", "name": "Ryu Hayabusa", "preview_url": "/api/characters/doa2_hayabusa/preview"}},
        {"slot": "RYU", "slot_name": "RYU", "status": "built", "donors": ["shadow"], "fit_preview": "",
         "donor": {"slug": "shadow", "name": "Shadow", "preview_url": "/api/characters/shadow/preview"},
         "original": {"slug": "doa2_ryu", "name": "Ryu", "preview_url": "/api/characters/doa2_ryu/preview"}},
        {"slot": "BAS", "slot_name": "BAS", "status": "built", "donors": ["knuckles"], "fit_preview": "",
         "donor": {"slug": "knuckles", "name": "Knuckles", "preview_url": "/api/characters/knuckles/preview"},
         "original": {"slug": "doa2_bass", "name": "Bass Armstrong", "preview_url": "/api/characters/doa2_bass/preview"}},
        {"slot": "TIN", "slot_name": "TIN", "status": "built", "donors": ["rouge"], "fit_preview": "",
         "donor": {"slug": "rouge", "name": "Rouge", "preview_url": "/api/characters/rouge/preview"},
         "original": {"slug": "doa2_tina", "name": "Tina Armstrong", "preview_url": "/api/characters/doa2_tina/preview"}},
        {"slot": "TEN", "slot_name": "TEN", "status": "built", "donors": ["big_the_cat"], "fit_preview": "",
         "donor": {"slug": "big_the_cat", "name": "Big the Cat", "preview_url": "/api/characters/big_the_cat/preview"},
         "original": null, "original_note": "no character of this game named like 'TEN' in the collection"}
      ],
      "codes": [{"type": "cheat", "label": "all costumes", "source": "marker"}, {"type": "unlock", "label": "Tengu playable", "source": "marker"}],
      "build_call": {"tool": "characters", "input": {"op": "cast_swap", "target_game": "doa2"}},
      "verification": {"verified": false, "last_launch": null, "launches": [], "text": "unverified in game until launched"}
    },
    "/api/builds/doa2/doa2_broken/details": {"$status": 500, "$body": {"detail": "fixture failure"}},
    "/api/jobs/jdoa2/fitting/files/amy-2.png": {"$placeholder": "Amy Rose (fit)", "hue": 330, "w": 256, "h": 256, "style": "fit"},
    "/api/characters/amy_rose/preview": {"$placeholder": "Amy Rose", "hue": 330, "w": 256, "h": 256},
    "/api/characters/sonic/preview": {"$placeholder": "Sonic", "hue": 220, "w": 256, "h": 256},
    "/api/characters/shadow/preview": {"$placeholder": "Shadow", "hue": 0, "w": 256, "h": 256},
    "/api/characters/knuckles/preview": {"$placeholder": "Knuckles", "hue": 350, "w": 256, "h": 256},
    "/api/characters/rouge/preview": {"$placeholder": "Rouge", "hue": 280, "w": 256, "h": 256},
    "/api/characters/big_the_cat/preview": {"$placeholder": "Big", "hue": 260, "w": 256, "h": 256},
    "/api/characters/doa2_kasumi/preview": {"$placeholder": "Kasumi", "hue": 25, "w": 256, "h": 256},
    "/api/characters/doa2_hayabusa/preview": {"$placeholder": "Hayabusa", "hue": 200, "w": 256, "h": 256},
    "/api/characters/doa2_ryu/preview": {"$placeholder": "Ryu", "hue": 40, "w": 256, "h": 256},
    "/api/characters/doa2_bass/preview": {"$placeholder": "Bass", "hue": 100, "w": 256, "h": 256},
    "/api/characters/doa2_tina/preview": {"$placeholder": "Tina", "hue": 55, "w": 256, "h": 256}
  },
  "launch_modded": "setTimeout(() => play('doa2', 'JAYBUILTFINALE', false, { disc: 'doa2_sonic_cast', slot: '' }), 300)",
  "shots": [
    {"name": "launch-mods-marquee", "url": "/#token=fixture", "viewport": [1280, 800],
     "actions": [{"wait": 900}, {"eval": "$launch_modded"}, {"wait_for": "#loader .lm-band"}, {"wait": 1300}]},
    {"name": "launch-mods-slides", "url": "/#token=fixture", "viewport": [1280, 800],
     "actions": [{"wait": 900}, {"eval": "$launch_modded"}, {"wait_for": "#loader .lm-card"}, {"wait": 2600}]},
    {"name": "launch-mods-reduced-motion", "url": "/#token=fixture", "viewport": [1280, 800], "reduced_motion": "reduce",
     "actions": [{"wait": 900}, {"eval": "$launch_modded"}, {"wait_for": "#loader .lm-card"}, {"wait": 900}]},
    {"name": "launch-mods-names-only", "url": "/#token=fixture", "viewport": [1280, 800],
     "actions": [{"wait": 900}, {"eval": "setTimeout(() => play('doa2', 'JAYBUILTFINALE', false, { disc: 'doa2_broken', slot: '' }), 300)"},
                 {"wait_for": "#loader .lm-info"}, {"wait": 900}]},
    {"name": "launch-stock", "url": "/#token=fixture", "viewport": [1280, 800],
     "actions": [{"wait": 900}, {"eval": "setTimeout(() => play('taxi', 'JAYBUILTFINALE', false, { disc: '', slot: '' }), 300)"},
                 {"wait_for": "#loader.on"}, {"wait": 2200}]},
    {"name": "launch-mods-narrow", "url": "/#token=fixture", "viewport": [760, 680],
     "actions": [{"wait": 900}, {"eval": "$launch_modded"}, {"wait_for": "#loader .lm-band"}, {"wait": 1500}]}
  ]
}
