  },
  "evidence": {
    "entities.base_pointer": "g_entities (0x804E38B0, .sbss, r13-0x7790): G_NextEntity (0x800990D0) walks g_entities[0 .. globals.num_entities) in 0x2B0 steps; gGameEntities (0x804E3520) is the renderer's copy of the same pointer (SIM_SetGameData)",
    "entities.count": "globals+0x80 = 0x803F0210: G_Spawn (0x80092CD0) increments it and passes it to gi.LocateGameData(g_entities, num_entities, 0x2B0, game.clients, 0x860)",
    "entities.stride": "0x2B0 = sizeof(gentity_t): the mulli in G_NextEntity/Entity::Entity and the LocateGameData call; active_edicts/free_edicts list heads are 688 bytes",
    "entities.inuse": "G_InitEdict (0x80098D10) stores 1 at edict+0x1E4; G_NextEntity and R_MarkVisibleEntities skip slots where it is 0",
    "entities.object": "Entity::Entity (0x80076D88) stores `this` at edict+0x24C; G_NextEntity returns it",
    "fields.number": "G_InitEdict computes (edict - g_entities) / 0x2B0 and stores it at edict+0; Entity::Entity copies it to Entity+0x10 (entnum)",
    "fields.class": "Entity::Entity stores __vt__6Entity at this+4 (Class puts the vtable pointer at +4, +0 is Class's own first word); every virtual call is lwz r12,4(r3); lwz r12,slot(r12)",
    "fields.classname": "Entity::Entity: vtable slot +8 (classinfo()) -> ClassDef, whose first word is the classname C string; stored at Entity+0x1C",
    "fields.client": "Entity::Entity copies edict+0x1E0 (gclient_t*) to Entity+0x18",
    "fields.model": "Entity::setModel (0x80075D00) stores the str at Entity+0x28; str = {strdata*}, strdata = {char *data, int refcount, int alloced, int len} (str::EnsureAlloced 0x8012B8F0)",
    "fields.position": "Entity::setOrigin (0x80074C64) writes Entity+0x8C..0x94 and copies it to edict+0x10, edict+0x1C and edict+0x22C (currentOrigin)",
    "fields.angles": "Entity::setAngles (0x800743F8) writes Entity+0x98..0xA0, then edict+0x34/+0x40/+0x238",
    "fields.mins/maxs/absmin/absmax": "setModel writes mins +0x2C / maxs +0x38 from the model bounds; Entity::link (0x80074FB8) copies edict+0x214/+0x220 (absmin/absmax after gi.linkentity) to Entity+0x44/+0x50 and the centroid to +0x68/edict+0x268",
    "fields.modelindex": "setModel: gi.setmodel(edict, name) then lwz r29,0x5C(edict); R_MarkVisibleEntities skips edicts with s.modelindex < 0",
    "fields.svflags": "R_MarkVisibleEntities (0x80015EBC): edict+0x124 & 0x80 -> not drawn; it ORs 0x40000000 into entities it marks visible this frame; G_InitEdict sets 0x20",
    "fields.parent": "edict+0x54 = s.parent, ENTITYNUM_NONE (0x804E38D0) when unbound (setOrigin)",
    "fields.model_handle": "setModel: result of gi+0xF0(edict) stored at Entity+0x144 (model/tiki handle)",
    "classes": "246 ClassDef registrations recovered from the __sinit_* static initialisers (ClassDef::ClassDef(this, classname, classID, superclass, responses, newInstance, size)); vtable addresses from the __vt__ symbols; 205 are Entity-derived",
    "camera": "see camera.why; gClientArr 0x804E3530, gClientSize 0x804E3534, gNumClients 0x804E3068, currentPlayer 0x804E34CC (all .sbss, reached through r13 = _SDA_BASE_ 0x804EB040)",
    "camera.eye": "PLAYER_ClientAdjustView (0x8000D7E4) adds PLAYER_GetViewposAdjustment to +0x74..0x7C and shake/roll to +0x68..0x70 before the renderer reads them: +0x74 is the final eye position",
    "camera.fov": "Player::SetFov (0x800DB038) keeps Player+0x424 between 90 and 160 (constants at 0x804E57B4/0x804E57B8); the renderer reads the client copy at gclient+0x2D0",
    "match.memory": "GameCube disc header is mirrored at 0x80000000; disc ID GW7E69 (header read from the GCZ)"
  },
