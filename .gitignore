# runtime state, secrets (api_token), DB, artifacts, downloaded cores/ghidra
gbox-data/
.venv*/
node_modules/
__pycache__/
.pytest_cache/
*.egg-info/
build/
dist/

# scratch files some emulator cores drop into their working directory
*.TMP

# per-machine settings written by the setup wizard (gBox.sh)
system/gbox.local-*.toml

# Local investigation captures, deployment staging, and generated test data.
/.work/

# PowerShell's machine-local module cache when running tools in this workspace.
/Microsoft/Windows/PowerShell/
